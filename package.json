{
  "name": "@stylelint-types/stylelint-order",
  "version": "8.1.3",
  "description": "TypeScript definitions for stylelint-define-config",
  "keywords": [
    "config",
    "configuration",
    "define-config",
    "scss",
    "stylelint",
    "stylelint-config",
    "stylelint-order",
    "stylelintconfig",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/stylelint-types/stylelint-order#readme",
  "bugs": "https://github.com/stylelint-types/stylelint-order/issues",
  "license": "MIT",
  "author": "pengzhanbo <volodymyr@foxmail.com> (https://github.com/pengzhanbo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/stylelint-types/stylelint-order.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint . --type-check --type-aware && oxfmt . --check",
    "format": "oxlint . --type-check --type-aware --fix && oxfmt .",
    "build": "tsdown",
    "release:publish": "pnpm publish",
    "release:changelog": "conventional-changelog -p angular && oxfmt ./CHANGELOG.md",
    "release": "bumpp package.json --execute=\"pnpm release:changelog\" --commit --all --push --tag"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.15.0",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "stylelint": "^18.0.0",
    "stylelint-define-config": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0",
    "stylelint-define-config": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
